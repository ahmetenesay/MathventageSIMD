NVL-E                = { Year: 2026, Vendor: "Intel", Socket: "LGA1954", Core: "ArcticWolf",       ISA: ["AVX10_2", "AVX512F", "APX_F", "FMA3", "AVX_VNNI"], Tier: 1 }
