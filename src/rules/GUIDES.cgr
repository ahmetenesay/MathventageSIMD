ATMEGA328P           = { Year: 2011, Vendor: "MicrochipAtmel", Board: "Arduino_Uno", Core: "AVR_8BIT_16M",     ISA: ["AVR_SOFTFLOAT_Q31"],                               Tier: 5, Cacheline: 0 }
SAMD21               = { Year: 2014, Vendor: "MicrochipAtmel", Board: "Arduino_Zero",Core: "Cortex-M0plus_48M",ISA: ["ARM_THUMB2_SOFTFLOAT"],                            Tier: 5, Cacheline: 32 }
SAME54               = { Year: 2017, Vendor: "MicrochipAtmel", Board: "SAME54-XPRO", Core: "Cortex-M4F_120M",  ISA: ["ARM_VFPv4_SP", "ARM_DSP"],                          Tier: 3, Cacheline: 32 }
SAMV71               = { Year: 2015, Vendor: "MicrochipAtmel", Board: "SAMV71-XULT", Core: "Cortex-M7_300M",   ISA: ["ARM_VFPv5_DP", "ARM_DSP"],                          Tier: 3, Cacheline: 32 }

# Texas Instruments Real-Time Control Digital Signal Controllers
TI_TMS320F28379D     = { Year: 2015, Vendor: "TexasInstruments", Board: "LAUNCHXL-F28379D", Core: "Dual_C28x_200M", ISA: ["TI_TMU_TRIG_COPROC", "TI_VCU2_COMPLEX"],     Tier: 3, Cacheline: 32 }

# =============================================================================
# SECTION 5: EMBEDDED MEMORY HIERARCHY, 100MB+ FOOTPRINT & XiP POLICY
# =============================================================================
# Embedded target reality: Microcontrollers lack gigabytes of volatile RAM.
# Storing 100+ MB of complete mathematical SIMD/coprocessor machine code
# (libsfmathventagesimd.img) requires a structured multi-tiered memory architecture.
# =============================================================================

[EMBEDDED_MEMORY_HIERARCHY_AND_XIP_POLICY]
# 1. Physical Target Flash Specification (QSPI / OctoSPI NOR)
TargetFlashCapacityBytes      = 134217728            # 128 MegaBytes (1024 MBit) minimum for 100MB+ image
TargetFlashMaxCapacityBytes   = 268435456            # 256 MegaBytes (2048 MBit) maximum density
TargetFlashPageSizeBytes      = 256                  # Standard page programming boundary
TargetFlashSectorSizeBytes    = 4096                 # 4 KB subsector erase granularity
TargetFlashBlockSizeBytes     = 65536                # 64 KB block erase granularity
TargetFlashOperatingVoltage   = 3.3                  # 3.3V logic supply
TargetFlashFootprint          = "WSON-8 (8x6mm)"     # Pin-compatible 8-pad DFN footprint

# 2. Qualified High-Density 1Gb / 2Gb Silicon Targets
TargetPart_128MB_Winbond      = "W25Q01JVZEIQ"       # JEDEC 0xEF4021, WSON-8, 3.3V, 133MHz
TargetPart_256MB_Winbond      = "W25Q02JVZEIQ"       # JEDEC 0xEF4022, WSON-8, 3.3V, 133MHz
TargetPart_128MB_Macronix     = "MX66L1G45GZ4I-08G"  # JEDEC 0xC2201B, WSON-8, 3.3V, 133MHz
TargetPart_256MB_Macronix     = "MX66L2G45GZ4I-08G"  # JEDEC 0xC2201C, WSON-8, 3.3V, 133MHz

# 3. Direct Memory-Mapped XiP (eXecute-In-Place) Configuration
XiP_MemoryMappedBaseAddress   = "0x90000000"         # STM32H7 QSPI/OctoSPI Bank 1 linear address
XiP_BusInterfaceClockMaxMHz   = 133                  # DDR mode achieves ~66-100 MB/s bandwidth
XiP_ZeroCopyInstructionFetch  = true                 # CPU pipeline fetches opcodes directly over QSPI

# 4. On-Demand Chunked Block Decompression Overlay Policy
ChunkDecompressionAlgorithm   = "Zstandard / LZ4"
TargetTCMBufferAddress        = "0x00000000"         # 64 KB ITCM (0-wait-state CPU tightly-coupled memory)
TargetAXISRAMBufferAddress    = "0x24000000"         # 512 KB AXI SRAM
TargetExternalSDRAMAddress    = "0xC0000000"         # 16 MB IS42S16160J SDRAM onboard Giga R1

# 5. Mass Storage Streaming Overlay (Zero-Soldering Drop-In Alternative)
EnableUSBAHostStreaming       = true                 # Read libsfmathventagesimd.img from USB-A Flash drive
EnableMicroSDIOStreaming      = true                 # Read libsfmathventagesimd.img from 4-bit SDIO SD card

# =============================================================================
# SECTION 6: MSC2020 DISCIPLINE TO SILICON RESOURCE MAPPING
# =============================================================================

[MSC2020_DISCIPLINE_SILICON_MAPPING]
MSC_11_NumberTheory           = { Codes: ["11-XX", "14-XX"], Silicon: ["MultiLimb_ADCX_ADOX", "PADDQ_256", "Montgomery_ALU"] }
MSC_15_LinearAlgebra          = { Codes: ["15-XX", "65Fxx"], Silicon: ["BLIS_5Level_Cache_Blocking", "FMA3_Pipelined", "AMX_SME_Tiles"] }
MSC_33_SpecialFunctions       = { Codes: ["33-XX", "41-XX"], Silicon: ["Minimax_Polynomial", "CORDIC_Q31", "TMU_Hardware", "DoubleDouble"] }
MSC_34_DifferentialEquations  = { Codes: ["34-XX", "35-XX"], Silicon: ["LBM_D2Q9_D3Q19", "FDTD_Yee_Cell", "NonTemporal_Stores"] }
MSC_05_CombinatoricsGraph     = { Codes: ["05-XX", "68Rxx"], Silicon: ["BMI1_BMI2_BitOps", "POPCNT", "PEXT_PDEP", "SIMD_Bitmask"] }
MSC_60_ProbabilityStochastics = { Codes: ["60-XX", "65Cxx"], Silicon: ["MersenneTwister_AVX2", "BoxMuller_SIMD", "MonteCarlo_FMA"] }
MSC_94_Cryptology             = { Codes: ["94A60"],         Silicon: ["ConstantTime_CMOV", "VPBLENDVB", "AESNI_CLMUL", "SideChannel_Resistant"] }
MSC_00_EmbeddedSoftFloat      = { Codes: ["00-XX"],         Silicon: ["SoftFloat_IEEE754", "FixedPoint_Q15_Q31", "ITCM_Overlay"] }

# =============================================================================
# SECTION 7: 6-TIER EXECUTION LADDER POLICY (Tiers 0 to 5)
# =============================================================================

[SIX_TIER_EXECUTION_LADDER_POLICY]
Tier0_MatrixTiles             = { Priority: 0, WidthBits: 2048, ISAs: ["AMX_TILE", "ARM_SME", "APPLE_AMX"] }
Tier1_WideVectorSIMD          = { Priority: 1, WidthBits: 512,  ISAs: ["AVX512F", "ARM_SVE2", "RISCV_VECTOR_1_0", "LOONGARCH_LASX"] }
Tier2_BasicVectorSIMD         = { Priority: 2, WidthBits: 256,  ISAs: ["AVX2_FMA", "ARM_NEON", "RISCV_VECTOR_0_7_1", "LOONGARCH_LSX", "E2K_VLIW"] }
Tier3_HardwareCoprocessors    = { Priority: 3, WidthBits: 128,  ISAs: ["ST_CORDIC", "ST_FMAC", "TI_TMU", "TI_VCU", "ARM_DSP", "XTENSA_PIE"] }
Tier4_ScalarHardwareFPU       = { Priority: 4, WidthBits: 64,   ISAs: ["IEEE754_FP32_FP64_STANDARD_FPU"] }
Tier5_IntegerSoftFloatALU     = { Priority: 5, WidthBits: 32,   ISAs: ["SOFTFLOAT_IEEE754", "FIXEDPOINT_Q15_Q31", "AVR_ALU"] }

# =============================================================================
# SECTION 8: ADAPTIVE MEMORY SAFETY & MICRO-GC CONTROL POLICY
# =============================================================================
# Large-scale Cartesian expansions over hundreds of thousands of LOC risk memory
# exhaustion. codegen.py enforces bounded chunk processing and explicit micro-GC.
# =============================================================================

[MEMORY_AND_GC_SAFETY]
MaxMemoryBudgetMB            = 512
BatchProcessingChunkSize     = 32
EnableMicroManualGC          = true
PurgePhantomBuffersImmediately = true

# =============================================================================
# SECTION 9: PRUNING & SCORING HEURISTIC ENGINE (Karar & Budama Parametreleri)
# =============================================================================

[HEURISTIC_WEIGHTS]
WeightReciprocalThroughput   = 0.45
WeightLatency                = 0.25
WeightPortContention         = 0.20
WeightRegisterSpillRisk      = 0.10

# Dynamic Fallback Ladder Bounds
LadderMinSteps               = 3
LadderMaxSteps               = 8
ContentionPenaltyThreshold   = 0.80
StreamingStoreThresholdBytes = 262144  # 256 KB (Bypass L2 cache threshold)

# =============================================================================
# SECTION 10: SAFETY-CRITICAL SPECIFICATION (SFVM-SC / Khronos SC Model)
# =============================================================================
# Aligned with Khronos Vulkan SC & ISO 26262 / DO-178C avionics & automotive:
# - Zero runtime dynamic allocations after initialization (Pre-allocated arenas)
# - Pure AOT (Ahead-of-Time) compilation (Zero JIT latency jitter during flight)
# - Hard bounded Worst-Case Execution Time (WCET) on all SIMD loops
# - Deterministic polling windows (sf_gc_safepoint_poll <= 100 microseconds)
# =============================================================================

[SAFETY_CRITICAL_PROFILE_SFVM_SC]
EnableSafetyCriticalMode      = false  # Default to Standard; set true for ASIL-D / DAL-A builds
ForbidRuntimeHeapAllocations  = true   # Zero malloc/free/mmap during mission execution loop
PreallocateStaticArenasOnly   = true   # Static memory reservation at boot
DisableRuntimeJITDeopt        = true   # Pure AOT pre-baked codex; eliminate de-optimization stalls
MaxBoundedIterationLimit      = 1000000# Enforced ceiling on all numerical stencils
EnforceMISRACompliantFallback = true   # Fail-safe state transition on hardware fault
