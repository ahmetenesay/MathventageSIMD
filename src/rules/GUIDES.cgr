TENSTORRENT_WORMHOLE = { Year: 2023, Vendor: "Tenstorrent",Core: "80x_Tensix", ISA: ["TENSIX_SIMD_FP16_BF16"],               Tier: 1, Cacheline: 64 }
TENSTORRENT_BLACKHOLE= { Year: 2024, Vendor: "Tenstorrent",Core: "120x_Tensix+16x_SiFive", ISA: ["TENSIX_SIMD_FP8_FP16", "RISCV_VECTOR_1_0"], Tier: 0, Cacheline: 64 }

[TARGET_ARCHITECTURES_EMBEDDED_MCU]
# STMicroelectronics High-Performance & Analog Coprocessor MCUs
STM32H747XI          = { Year: 2019, Vendor: "STMicroelectronics", Board: "Arduino_Giga_R1", Core: "Dual_M7_480M_M4_240M", ISA: ["ARM_VFPv5_DP", "ARM_DSP", "ST_CORDIC", "ST_FMAC"], Tier: 3, Cacheline: 32 }
STM32H5F5            = { Year: 2023, Vendor: "STMicroelectronics", Board: "Ventuno_Q_MCU",   Core: "Cortex-M33_250M",        ISA: ["ARM_VFPv5_SP", "ARM_DSP"],                          Tier: 3, Cacheline: 32 }
STM32U585            = { Year: 2022, Vendor: "STMicroelectronics", Board: "Uno_Q_MCU",       Core: "Cortex-M33_160M",        ISA: ["ARM_VFPv5_SP", "ARM_DSP"],                          Tier: 3, Cacheline: 32 }
STM32G474            = { Year: 2019, Vendor: "STMicroelectronics", Board: "NUCLEO-G474RE",   Core: "Cortex-M4F_170M",        ISA: ["ARM_VFPv4_SP", "ST_CORDIC", "ST_FMAC"],             Tier: 3, Cacheline: 32 }
STM32F407            = { Year: 2011, Vendor: "STMicroelectronics", Board: "STM32F4-DISCO",   Core: "Cortex-M4F_168M",        ISA: ["ARM_VFPv4_SP", "ARM_DSP"],                          Tier: 4, Cacheline: 32 }

# Raspberry Pi Microcontrollers
RP2040               = { Year: 2021, Vendor: "RaspberryPi", Board: "Pico",     Core: "Dual_M0plus_133M",       ISA: ["ARM_THUMB2", "BOOTROM_SOFTFLOAT"],                 Tier: 5, Cacheline: 32 }
RP2350               = { Year: 2024, Vendor: "RaspberryPi", Board: "Pico2",    Core: "Dual_M33F_Hazard3_150M", ISA: ["ARM_VFPv5_DP_COPROC", "ARM_DSP", "RISCV_RV32IMAF"],Tier: 3, Cacheline: 32 }

# Espressif Wireless AI & Vector SoCs
ESP8266              = { Year: 2014, Vendor: "Espressif",   Board: "NodeMCU",  Core: "Xtensa_L106_80M",        ISA: ["XTENSA_SOFTFLOAT"],                                Tier: 5, Cacheline: 16 }
ESP32                = { Year: 2016, Vendor: "Espressif",   Board: "ESP32-DevKit", Core: "Dual_LX6_240M",      ISA: ["XTENSA_FPU_SP"],                                   Tier: 4, Cacheline: 32 }
ESP32_S3             = { Year: 2021, Vendor: "Espressif",   Board: "ESP32-S3", Core: "Dual_LX7_240M",          ISA: ["XTENSA_PIE_128BIT_VECTOR"],                        Tier: 3, Cacheline: 32 }
ESP32_P4             = { Year: 2024, Vendor: "Espressif",   Board: "ESP32-P4", Core: "Dual_RISCV_400M",        ISA: ["RISCV_VECTOR_EXT", "H264_ACCEL"],                  Tier: 3, Cacheline: 64 }

