# =============================================================================
# MathventageSIMD — GUIDES.cgr
# Comprehensive Hardware Scoping, Global Silicon Matrix & Pruning Policy Codex
# =============================================================================
# Architectures: Intel, AMD, Chinese Silicon (Loongson, Zhaoxin, Phytium, T-Head,
# Hygon, Sunway), Japanese Silicon (Fujitsu A64FX, NEC SX-Aurora, Renesas),
# Apple Silicon (M1-M4), Qualcomm (Oryon), and DIY SBCs (RPi, Rockchip, Allwinner).
# =============================================================================

[POLICY_METADATA]
Version              = 3.0.0
Codename             = "GlobalSiliconCompute"
TargetDomain         = "Pure-CPU-Mathematical-SIMD-Acceleration"
PrimaryLanguage      = "C++20"
OutputArtifact       = "Mathventory.bc"

# =============================================================================
# SECTION 1: TEMPORAL FILTER & ARCHITECTURAL FOUNDATION (2011 - 2026)
# =============================================================================
# ARCHITECTURAL ASSESSMENT: WHY 2011 IS THE SCIENTIFIC MINIMUM BOUNDARY:
#
# 1. Vector FPU Pipeline Execution:
#    Pre-2011 architectures (Intel Core 2 Penryn 2007-2008, AMD Phenom II 2008,
#    Pentium 4 NetBurst 2000-2006) lack pipelined 256-bit AVX execution units and
#    FMA (Fused Multiply-Add). Every multiply-accumulate requires separate FMUL +
#    FADD instructions, doubling execution latency and register pressure.
#
# 2. Unaligned Vector Memory Penalty:
#    Pre-2011 microarchitectures incur severe 2-3 split load micro-op penalties
#    and pipeline stalls whenever memory operands cross cache line boundaries.
#    Sandy Bridge (2011) introduced hardware unaligned load buffers that eliminated
#    this penalty for streaming mathematical stencils.
#
# 3. Cache & Memory Bandwidth Floor:
#    Mathematical solvers (FDTD wave equations, Maxwell Yee, LBM fluid steps)
#    require continuous memory throughput exceeding 12.8 GB/s (DDR3-1600+).
#    DDR2 and early DDR3 bus architectures saturate instantly, starving vector ALUs.
#
# 4. Modern OoO Schedulers:
#    2011 marks the advent of Sandy Bridge, AMD Bulldozer, and ARM Cortex-A15,
#    introducing wide out-of-order schedulers, decoupled load/store queues, and
#    non-temporal write-combining streaming buffers.
# =============================================================================

[TEMPORAL_FILTER]
MinReleaseYear       = 2011
MaxReleaseYear       = 2026
RequireHardwareFPU   = true
Require64BitAddress  = true
MinimumVectorBits    = 128
MemoryBandwidthFloorGBs = 12.8

# =============================================================================
# SECTION 2: INTEL PENTIUM, CELERON & ATOM SPECIFICATION
# =============================================================================
# Intel manufactured and actively evolved Pentium, Celeron, and Atom processors
# through late 2023. Archaic pre-2011 models (NetBurst, P54C, P55C, Coppermine,
# Northwood, Prescott, Conroe-L) are strictly excluded.
# Modern low-power and budget cores found in DIY SBCs, NAS devices, and budget PCs
# (2013-2023) are explicitly supported.
# =============================================================================

[ATOM_CELERON_PENTIUM_SCOPE]
IncludeSilvermont    = true   # Bay Trail (2013, SSE4.2, Out-of-Order)
IncludeGoldmont      = true   # Apollo Lake (2016, GLM in uops.info)
IncludeGoldmontPlus  = true   # Gemini Lake / Pentium Silver J5005 (2017)
IncludeTremont       = true   # Jasper Lake / Celeron N5105 (2020, TRM in uops.info)
IncludeGracemont     = true   # Alder Lake-N / Intel Processor N100 / N200 (2023, ADL-E in uops.info)
IncludePentiumGold   = true   # Kaby Lake / Comet Lake / Alder Lake Pentium Gold G7400 (2017-2023)

# =============================================================================
# SECTION 3: AUTONOMOUS x86 ARCHITECTURE SCRUTINY & REJECTION ENGINE
# =============================================================================
# Instead of hardcoding which x86 CPUs are qualified, codegen.py autonomously
# evaluates every microarchitecture discovered in instructions.xml against a
# rigorous vector compute SLA.
#
# Compute Efficiency Metric:
#   Score = (VectorWidthBits / 128) * (1.0 / (Throughput_FMA * Latency_FMA * (1 + PortPenalty)))
#
# If a CPU lacks hardware FMA, has severe port contention (> 0.85), or scores
# below AutoQualificationThreshold, codegen.py autonomously rejects it with an
# explicit diagnostic log and prunes it from the final synthesis codex!
# =============================================================================

[AUTONOMOUS_X86_EVALUATION_SLA]
EnableAutonomousX86Scrutiny   = true
AutoQualificationThreshold    = 1.15
MaxAllowablePortPressure      = 0.85
RequireHardwareFMA            = true
StrictDiagnosticLogging       = true

# =============================================================================
# SECTION 4: GLOBAL TARGET MICROARCHITECTURE MATRIX
# =============================================================================

[TARGET_ARCHITECTURES_INTEL]
